# .env.example
# Copy this file to .env and adjust values as needed.
# All settings are optional — Envel falls back to sensible defaults
# under data/ if .env is missing entirely.

# ----- Mail Source Selection
# "gmail" | "graph" | "imap" — only "gmail" is implemented so far.
ENVEL_MAIL_SOURCE=gmail

# ----- Gmail / Graph Auth
# Path to the OAuth client secret file downloaded from Google Cloud Console.
ENVEL_CREDENTIALS_PATH=data/auth/credentials.json
# Path to the file holding the access/refresh token after the first OAuth flow.
ENVEL_TOKEN_PATH=data/auth/token.json

# ----- Query Config
# Path to the YAML file defining which emails to fetch
# (label, sender, date range, etc.).
ENVEL_QUERY_CONFIG_PATH=data/query_config.yaml

# ----- Logs
ENVEL_LOG_DIR=data/logs/envel

# ----- Pipeline Output
# Temporary location where Envel writes the normalized raw data
# fetched from Gmail, to be read by Pluggle's Extract stage.
ENVEL_RAW_OUTPUT_DIR=data/output/envel